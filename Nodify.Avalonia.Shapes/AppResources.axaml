<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dashed DodgerBlue pen consumed by BaseConnection's keyboard focus visual via FocusVisualPenKey. -->
    <Pen x:Key="FocusVisualPen"
         Brush="DodgerBlue"
         Thickness="1"
         DashStyle="{x:Static DashStyle.Dash}" />

    <!-- ICONS -->

    <DataTemplate x:Key="MinusIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M5 12h14" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="PlusIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M12 5v14M5 12h14" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="MaximizeIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M4 8V6a2 2 0 0 1 2-2h2M4 16v2a2 2 0 0 0 2 2h2M16 4h2a2 2 0 0 1 2 2v2M16 20h2a2 2 0 0 0 2-2v-2" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CursorIcon">
        <Viewbox Stretch="Fill" Margin="2">
            <Path Stroke="White"
                  StrokeThickness="1"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M.256.255a.874.874 0 0 0-.18.974l4.753 17.114a.875.875 0 0 0 1.603-.012L10 10l8.334-3.57a.875.875 0 0 0 .01-1.601L1.23.075a.874.874 0 0 0-.974.18Z" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CircleIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SquareIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="TriangleIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M10.363 3.591 2.257 17.125a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636-2.87L13.637 3.59a1.914 1.914 0 0 0-3.274 0z" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ArrowBackIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="m9 14-4-4 4-4" />
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M5 10h11a4 4 0 1 1 0 8h-1" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ArrowForwardIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="m15 14 4-4-4-4" />
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M19 10H8a4 4 0 1 0 0 8h1" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LockIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M5 13a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6z" />
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M11 16a1 1 0 1 0 2 0 1 1 0 0 0-2 0M8 11V7a4 4 0 1 1 8 0v4" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="LockOpenIcon">
        <Viewbox Stretch="Fill">
            <Canvas Width="24" Height="24">
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M5 13a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z" />
                <Path Stroke="White"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Data="M11 16a1 1 0 1 0 2 0 1 1 0 1 0-2 0M8 11V6a4 4 0 0 1 8 0" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="PART_Border"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
