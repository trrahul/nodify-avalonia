<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Nodify.Avalonia.Workflow.Common"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             x:Class="Nodify.Avalonia.Workflow.Designer.WorkflowToolBar"
             x:Name="Root">

    <Border Padding="8"
            CornerRadius="{DynamicResource OverlayCornerRadius}"
            Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentControlElevationBorderBrush}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Button Theme="{StaticResource BorderlessButton}"
                    ToolTip.Tip="Zoom in">
                <Button.Command>
                    <nodify:TargetedRoutedCommand
                        Command="{x:Static nodify:EditorCommands.ZoomIn}"
                        Target="{Binding Editor, ElementName=Root}" />
                </Button.Command>
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="{StaticResource Icon.ZoomIn}" />
            </Button>

            <TextBlock Text="{Binding Editor.ViewportZoom, ElementName=Root, Converter={x:Static common:ZoomToPercentConverter.Instance}}"
                       Margin="4 0 4 4"
                       VerticalAlignment="Center" />

            <Button Theme="{StaticResource BorderlessButton}"
                    ToolTip.Tip="Zoom out">
                <Button.Command>
                    <nodify:TargetedRoutedCommand
                        Command="{x:Static nodify:EditorCommands.ZoomOut}"
                        Target="{Binding Editor, ElementName=Root}" />
                </Button.Command>
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="{StaticResource Icon.ZoomOut}" />
            </Button>

            <Border Classes="Separator" Theme="{StaticResource SeparatorBorder}" />

            <Button Theme="{StaticResource BorderlessButton}"
                    ToolTip.Tip="Fit to view">
                <Button.Command>
                    <nodify:TargetedRoutedCommand
                        Command="{x:Static nodify:EditorCommands.FitToScreen}"
                        Target="{Binding Editor, ElementName=Root}" />
                </Button.Command>
                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="{StaticResource Icon.FullScreenMaximize}" />
            </Button>

            <ContentControl Content="{Binding LockViewCommand}"
                            Focusable="False" />

            <Border Classes="Separator" Theme="{StaticResource SeparatorBorder}" />

            <Button Theme="{StaticResource BorderlessButton}"
                    ToolTip.Tip="More actions">
                <!-- Stretched ink anchors top-left; a box + centered auto-sized Path keeps
                     non-square glyphs centered. -->
                <Grid Width="12" Height="12">
                    <Path Stretch="Uniform" StrokeThickness="1.3"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                          Data="{StaticResource Icon.MoreHorizontal}" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
