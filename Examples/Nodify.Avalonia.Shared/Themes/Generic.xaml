<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Nodify"
                    xmlns:controls="clr-namespace:Nodify.Avalonia.Shared.Controls"
                    xmlns:converters="clr-namespace:Nodify.Avalonia.Shared.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Controls.xaml" />
        <ResourceInclude Source="/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type controls:EditableTextBlock}"
                  TargetType="{x:Type controls:EditableTextBlock}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="DodgerBlue" />
        <Setter Property="MinHeight"
                Value="{Binding FontSize, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EditableTextBlock}">
                    <Grid VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                        <TextBlock Text="{Binding Text, ElementName=PART_TextBox}"
                                   Background="{TemplateBinding Background}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   Padding="{TemplateBinding Padding}"
                                   TextTrimming="{TemplateBinding TextTrimming}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   x:Name="PART_Text" />
                        <TextBox Text="{Binding Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 MinWidth="{TemplateBinding MinWidth}"
                                 MinHeight="{TemplateBinding MinHeight}"
                                 Background="{TemplateBinding Background}"
                                 Foreground="{TemplateBinding Foreground}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 AcceptsReturn="{TemplateBinding AcceptsReturn}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="{TemplateBinding Padding}"
                                 MaxLength="{TemplateBinding MaxLength}"
                                 MinLines="{TemplateBinding MinLines}"
                                 MaxLines="{TemplateBinding MinLines}"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 AcceptsTab="True"
                                 IsVisible="False"
                                 Margin="-1"
                                 x:Name="PART_TextBox" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[IsEditing=True] /template/ TextBox#PART_TextBox">
            <Setter Property="IsVisible"
                    Value="True" />
        </Style>
        <Style Selector="^[IsEditing=True] /template/ TextBlock#PART_Text">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>
    </ControlTheme>
    <converters:ResizeDirectionToVisibilityConverter x:Key="ResizeDirectionToVisibilityConverter" />
    <converters:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
    <converters:SwatchSelectionBackgroundConverter x:Key="SwatchSelectionBackgroundConverter" />

    <!--<ControlTheme  TargetType="{x:Type controls:EditableTextBlock}" BasedOn="{StaticResource EditableTextBlockBaseStyle}"/>-->
    <ControlTheme TargetType="{x:Type controls:TabControlEx}" x:Key="{x:Type controls:TabControlEx}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabControlEx}">
                    <Grid KeyboardNavigation.TabNavigation="Local" 
                          UseLayoutRounding="true"
                          ClipToBounds="true">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Panel.ZIndex ="1"
                              Margin="2,2,2,0"
                              Background="{TemplateBinding Background}"
                              KeyboardNavigation.TabIndex="1">
                            <ScrollViewer x:Name="PART_ScrollViewer" 
                                          HorizontalScrollBarVisibility="Auto" 
                                          VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter">
                                        <ItemsPresenter.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsPresenter.ItemsPanel>
                                    </ItemsPresenter>
                                    
                                    <Button Theme="{DynamicResource IconButton}"
                                            Command="{TemplateBinding AddTabCommand}"
                                            Height="34"
                                            VerticalAlignment="Bottom"
                                            BorderBrush="{DynamicResource HighlightedBackgroundBrush}"
                                            Grid.Column="1"
                                            ToolTip.Tip="Add new tab">
                                        <Path Width="25" 
                                              Height="15"
                                              Data="{DynamicResource AddGeometry}"
                                              Fill="{TemplateBinding Foreground}" 
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                        <Border x:Name="ContentPanel"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            KeyboardNavigation.TabNavigation="Local"
                                            
                                            KeyboardNavigation.TabIndex="2"
                                            Grid.Row="1">
                            <!--KeyboardNavigation.DirectionalNavigation="Contained"-->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              UseLayoutRounding="{TemplateBinding UseLayoutRounding}"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[IsEnabled=False]">
            <Setter Property="Opacity" 
                    Value=".5"/>
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="{x:Type controls:TabItemEx}" x:Key="{x:Type controls:TabItemEx}">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="RenderTransformOrigin"
                Value="0.5,1"/>
        <Setter Property="VerticalAlignment" 
                Value="Bottom"/>
        <Setter Property="VerticalContentAlignment" 
                Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" 
                Value="Stretch"/>
        <Setter Property="Padding"
                Value="7"/>
        <Setter Property="ToolTip.Tip"
                Value="Double click to edit"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabItemEx}">
                    <Border x:Name="mBorder"
                            BorderThickness="1" 
                            CornerRadius="5 5 0 0"
                            Background="{TemplateBinding Background}"  
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <controls:EditableTextBlock Text="{TemplateBinding Header}"
                                                         Foreground="{TemplateBinding Foreground}"/>
                                <Button x:Name="mCloseBtn" 
                                        Command="{TemplateBinding CloseTabCommand}" 
                                        CommandParameter="{TemplateBinding CloseTabCommandParameter}" 
                                        Opacity="0"
                                        Margin="5 0 0 0" 
                                        Background="{DynamicResource HighlightedBackgroundBrush}"
                                        BorderBrush="{DynamicResource BackgroundBrush}"
                                        Theme="{DynamicResource IconButton}"
                                        ToolTip.Tip="Close Tab">
                                    <Path Width="16"
                                          Height="8"
                                          Data="{DynamicResource CloseGeometry}" 
                                          Fill="{TemplateBinding Foreground}" 
                                          Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:pointerover /template/ Button#mCloseBtn">
            <Setter Property="Opacity" 
                    Value="1" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" 
                    Value="{DynamicResource HighlightedBackgroundBrush}"/>
        </Style>
        <Style Selector="^[IsSelected=True] /template/ Button#mCloseBtn">
            <Setter Property="Opacity" 
                    Value="1" />
        </Style>
        <Style Selector="^[IsSelected=True]">
            <Setter Property="TextElement.FontWeight" 
                    Value="Bold"/>
            <Setter Property="Background" 
                    Value="{DynamicResource HighlightedBackgroundBrush}"/>
            <Setter Property="Padding"
                    Value="8"/>
        </Style>
        <!-- Entrance animation: scale from 0 to 1 on Y when the tab item is created.
             Avalonia plays Animations in a Style once on first apply (no trigger needed). -->
        <Style Selector="^">
            <Style.Animations>
                <Animation Duration="0:0:0.5" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%" KeySpline="0.2,1.8,0.6,1">
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="{x:Type controls:Swatches}" x:Key="{x:Type controls:Swatches}">
        <Setter Property="Background"
                Value="#1e293b" />
        <Setter Property="Padding"
                Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Swatches}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8">
                        <ItemsControl ItemsSource="{TemplateBinding Colors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="50"
                                            Padding="1"
                                            Margin="3">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource SwatchSelectionBackgroundConverter}">
                                                <Binding />
                                                <Binding Path="SelectedColor"
                                                         RelativeSource="{RelativeSource AncestorType={x:Type controls:Swatches}}" />
                                            </MultiBinding>
                                        </Border.Background>
                                        <Ellipse Width="24"
                                                 Height="24"
                                                 Stroke="#1e293b"
                                                 Fill="{Binding ., Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                                 Cursor="Hand" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity"
                    Value="0.7" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="{x:Type controls:ResizablePanel}" x:Key="{x:Type controls:ResizablePanel}">
        <Setter Property="BorderBrush"
                Value="#1e293b" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ResizablePanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="False">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <controls:Resizer Direction="TopLeft"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=TopLeft}" />

                            <controls:Resizer Direction="TopRight"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=TopRight}" />

                            <controls:Resizer Direction="BottomLeft"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Bottom"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=BottomLeft}" />

                            <controls:Resizer Direction="BottomRight"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=BottomRight}" />

                            <controls:Resizer Direction="Left"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=Left}" />

                            <controls:Resizer Direction="Right"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=Right}" />

                            <controls:Resizer Direction="Top"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=Top}" />

                            <controls:Resizer Direction="Bottom"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              IsVisible="{TemplateBinding Directions, Converter={StaticResource ResizeDirectionToVisibilityConverter}, ConverterParameter=Bottom}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="{x:Type controls:Resizer}" x:Key="{x:Type controls:Resizer}">
        <Setter Property="Background"
                Value="#1e293b" />
        <Setter Property="Width"
                Value="6" />
        <Setter Property="Height"
                Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Resizer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[Direction=TopLeft]">
            <Setter Property="Cursor"
                    Value="TopLeftCorner" />
            <Setter Property="Margin"
                    Value="-4 -4 0 0" />
        </Style>
        <Style Selector="^[Direction=TopRight]">
            <Setter Property="Cursor"
                    Value="TopRightCorner" />
            <Setter Property="Margin"
                    Value="0 -4 -4 0" />
        </Style>
        <Style Selector="^[Direction=BottomLeft]">
            <Setter Property="Cursor"
                    Value="BottomLeftCorner" />
            <Setter Property="Margin"
                    Value="-4 0 0 -4" />
        </Style>
        <Style Selector="^[Direction=BottomRight]">
            <Setter Property="Cursor"
                    Value="BottomRightCorner" />
            <Setter Property="Margin"
                    Value="0 0 -4 -4" />
        </Style>
        <Style Selector="^[Direction=Left]">
            <Setter Property="Cursor"
                    Value="SizeWestEast" />
            <Setter Property="Margin"
                    Value="-4 0 0 0" />
        </Style>
        <Style Selector="^[Direction=Right]">
            <Setter Property="Cursor"
                    Value="SizeWestEast" />
            <Setter Property="Margin"
                    Value="0 0 -4 0" />
        </Style>
        <Style Selector="^[Direction=Top]">
            <Setter Property="Cursor"
                    Value="SizeNorthSouth" />
            <Setter Property="Margin"
                    Value="0 -4 0 0" />
        </Style>
        <Style Selector="^[Direction=Bottom]">
            <Setter Property="Cursor"
                    Value="SizeNorthSouth" />
            <Setter Property="Margin"
                    Value="0 0 0 -4" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
