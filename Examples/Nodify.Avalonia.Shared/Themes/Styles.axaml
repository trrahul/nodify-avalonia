<Style xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shared="clr-namespace:Nodify.Avalonia.Shared;assembly=Nodify.Avalonia.Shared">
    <Style.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="Nodify.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <!--"Default" is kept (duplicated) alongside the named variant below:
                    StaticResource lookup for resources nested in inline XAML (e.g. an app's
                    <ControlTheme BasedOn="{StaticResource ...}"/>) resolves against
                    ThemeVariant.Default when the ambient live variant isn't established yet at
                    that parse point; dropping "Default" throws KeyNotFoundException there even
                    though DynamicResource lookups against the real ActualThemeVariant work fine.-->
                <ResourceDictionary x:Key="{x:Static shared:ThemeManager.NodifyVariant}">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="Nodify.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="Light.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="Dark.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Style.Resources>
</Style>
