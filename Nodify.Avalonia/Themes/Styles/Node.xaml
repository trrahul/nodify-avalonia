<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Nodify" 
                    xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes">

    <DataTemplate x:Key="DefaultInputConnectorTemplate">
        <nodes:NodeInput />
    </DataTemplate>
    <DataTemplate x:Key="DefaultOutputConnectorTemplate">
        <nodes:NodeOutput />
    </DataTemplate>

    <ControlTheme x:Key="DefaultHeaderContainerTheme" TargetType="Border">
        <Setter Property="CornerRadius"
                Value="3 3 0 0" />
        <Setter Property="Padding"
                Value="6 4 6 4" />
    </ControlTheme>
    <ControlTheme x:Key="DefaultFooterContainerTheme" TargetType="Border">
        <Setter Property="CornerRadius"
                Value="0 0 3 3" />
        <Setter Property="Padding"
                Value="6 4 6 4" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type nodes:Node}" TargetType="nodes:Node">
        <Setter Property="Background"
                Value="{DynamicResource Node.BackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Node.ForegroundBrush}" />
        <Setter Property="ContentBrush"
                Value="{DynamicResource Node.ContentBrush}" />
        <Setter Property="HeaderBrush"
                Value="{DynamicResource Node.HeaderBrush}" />
        <Setter Property="FooterBrush"
                Value="{DynamicResource Node.FooterBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Node.BorderBrush}" />
        <Setter Property="MinHeight"
                Value="15" />
        <Setter Property="MinWidth"
                Value="15" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="InputConnectorTemplate"
                Value="{StaticResource DefaultInputConnectorTemplate}" />
        <Setter Property="OutputConnectorTemplate"
                Value="{StaticResource DefaultOutputConnectorTemplate}" />
        <Setter Property="HeaderContainerStyle"
                Value="{StaticResource DefaultHeaderContainerTheme}" />
        <Setter Property="FooterContainerStyle"
                Value="{StaticResource DefaultFooterContainerTheme}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--Header-->
                            <Border x:Name="PART_HeaderContainer"
                                    IsVisible="{TemplateBinding HasHeader}"
                                    Background="{TemplateBinding HeaderBrush}"
                                    Theme="{TemplateBinding HeaderContainerStyle}"
                                    Grid.ColumnSpan="3">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                            </Border>

                            <!--Body-->
                            <Border x:Name="PART_ContentContainer"
                                    Theme="{TemplateBinding ContentContainerStyle}"
                                    Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--Data IN-->
                                    <ItemsControl ItemsSource="{TemplateBinding Input}" Grid.Column="0"
                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                  ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                                                  Focusable="False" />

                                    <!--Content-->
                                    <Border Grid.Column="1"
                                            Padding="{TemplateBinding ContentPadding}"
                                            Background="{TemplateBinding ContentBrush}">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                    </Border>

                                    <!--Data OUT-->
                                    <ItemsControl ItemsSource="{TemplateBinding Output}"
                                                  ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                  HorizontalAlignment="Right"
                                                  Grid.Column="2"
                                                  Focusable="False" />
                                </Grid>
                            </Border>

                            <!--Footer-->
                            <Border x:Name="PART_FooterContainer"
                                    IsVisible="{TemplateBinding HasFooter}"
                                    Background="{TemplateBinding FooterBrush}"
                                    Theme="{TemplateBinding FooterContainerStyle}"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="3">
                                <ContentPresenter Content="{TemplateBinding Footer}"
                                                  ContentTemplate="{TemplateBinding FooterTemplate}"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[HasHeader=true]">
            <Setter Property="Background"
                    Value="{DynamicResource Node.BackgroundBrush}" />
            <Setter Property="ContentBrush"
                    Value="{DynamicResource Node.ContentBrush}" />
            <Setter Property="HeaderBrush"
                    Value="{DynamicResource Node.HeaderBrush}" />
            <Setter Property="FooterBrush"
                    Value="{DynamicResource Node.FooterBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Node.BorderBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Node.HeaderForegroundBrush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
