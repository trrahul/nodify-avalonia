<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Nodify.Avalonia.Playground.ViewModels"
             xmlns:views="clr-namespace:Nodify.Avalonia.Playground.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nodify.Avalonia.Playground.Views.PlaygroundSettingsView"
             x:DataType="viewModels:PlaygroundViewModel">
    <Border BorderThickness="1"
            Padding="10"
            HorizontalAlignment="Stretch">
        <views:SettingsView Items="{Binding Settings.Settings}" />
    </Border>
</UserControl>
