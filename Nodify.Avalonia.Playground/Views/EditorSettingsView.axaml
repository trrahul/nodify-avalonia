<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Nodify.Avalonia.Playground"
             xmlns:views="clr-namespace:Nodify.Avalonia.Playground.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nodify.Avalonia.Playground.Views.EditorSettingsView">
    <Border BorderThickness="1"
            Padding="10"
            HorizontalAlignment="Stretch">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:SettingsView Items="{Binding Settings, Source={x:Static local:EditorSettings.Instance}}" />

            <Expander Grid.Row="1"
                      Header="Advanced"
                      Padding="0 5 0 0"
                      BorderThickness="0 0 0 1"
                      IsExpanded="True"
                      BorderBrush="{DynamicResource BackgroundBrush}">
                <Expander.Styles>
                    <Style Selector="Expander">
                        <Setter Property="Tag"
                                Value="{StaticResource ExpandRightIcon}" />
                    </Style>
                    <Style Selector="Expander[IsExpanded=True]">
                        <Setter Property="Tag"
                                Value="{StaticResource ExpandDownIcon}" />
                    </Style>
                </Expander.Styles>

                <Border BorderThickness="1"
                        HorizontalAlignment="Stretch">
                    <views:SettingsView Items="{Binding AdvancedSettings, Source={x:Static local:EditorSettings.Instance}}" />
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
