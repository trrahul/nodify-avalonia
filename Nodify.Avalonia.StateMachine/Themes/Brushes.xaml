<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PanelBackgroundColor">#2D2D30</Color>
            <Color x:Key="ActiveStateColor">#8DD28A</Color>
            <Color x:Key="ReadOnlyStateColor">#E6AF86</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PanelBackgroundColor">#E9EEFE</Color>
            <Color x:Key="ActiveStateColor">#8DD28A</Color>
            <Color x:Key="ReadOnlyStateColor">#E6AF86</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <!-- "Nodify" purple theme -->
            <Color x:Key="PanelBackgroundColor">#2A1B47</Color>
            <Color x:Key="ActiveStateColor">#A6D99C</Color>
            <Color x:Key="ReadOnlyStateColor">#FD5618</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="ActiveStateBrush" Color="{DynamicResource ActiveStateColor}" />
    <SolidColorBrush x:Key="ReadOnlyStateBrush" Color="{DynamicResource ReadOnlyStateColor}" />
</ResourceDictionary>
