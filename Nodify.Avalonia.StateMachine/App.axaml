<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Nodify.Avalonia.StateMachine"
             x:Class="Nodify.Avalonia.StateMachine.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Themes/Icons.xaml"/>
                <ResourceInclude Source="Themes/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml"/>
        <StyleInclude Source="avares://Nodify.Avalonia.Shared/Themes/Styles.axaml"/>
    </Application.Styles>

    <!-- Renders DrawingBrush icon resources (Themes/Icons.xaml) as a sized Rectangle at sites
         not covered by an IconButton/IconCheckBox theme, instead of showing the brush type name. -->
    <Application.DataTemplates>
        <DataTemplate x:DataType="DrawingBrush">
            <Rectangle Fill="{Binding}" Width="16" Height="16" />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
